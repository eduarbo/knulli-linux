#!/bin/sh

WAKE_TIME="/var/run/rtc-wake.epoch"
SHUTDOWN_FLAG="/var/run/shutdown.flag"
IDLE_STATE_FILE="/var/run/idle.state"
LOCK_FILE="/var/run/knulli-suspend.lock"
LOG_FILE="/var/log/knulli-suspend.log"

# Power off after this long suspended (system.suspend.shutdowntimer, seconds,
# 0 = never). Unset means 3 h: suspended, an RG35XX-H loses about 5.5 % per
# hour, and DraStic could no longer get video memory after 5.5 h suspended.
DEFAULT_SUSPEND_TIMER=10800
# Also power off before the charge falls below this level while suspended
# (system.suspend.shutdownbattery, percent, 0 = off), at 6 % per hour.
DEFAULT_SUSPEND_BATTERY=5
SECS_PER_PERCENT=600

exec 9>"${LOCK_FILE}"
if ! flock -n 9; then
  exit 0
fi

trap 'flock -u 9;' EXIT

# Abort if system is shutting down
if [ -f "$SHUTDOWN_FLAG" ]; then
  exit 0
fi

save_time() {
  local TIMER="$1"

  now=$(date +%s)
  target=$(( now + TIMER ))
  echo "$target" > "$WAKE_TIME"
}

clear_rtcs() {
  for r in /sys/class/rtc/rtc*; do
    [ -w "$r/wakealarm" ] && echo 0 > "$r/wakealarm" 2>/dev/null
  done
}

arm_rtcs() {
  secs="$1"
  armed=0
  for r in /sys/class/rtc/rtc*; do
    [ -d "$r" ] || continue
    dev="${r##*/}"

    # Allow as wake source if supported
    [ -w "$r/device/power/wakeup" ] && echo enabled > "$r/device/power/wakeup" 2>/dev/null

    # Program alarm only; don't suspend here
    if rtcwake -d "$dev" -m no -s "$secs" >/dev/null 2>&1; then
      armed=1
      continue
    fi

  done
  [ "$armed" -eq 1 ]  # returns 0 if at least one armed, 1 otherwise
}

log() {
  echo "$(date -u +%FT%TZ) $*" >> "$LOG_FILE" 2>/dev/null
}

# Knulli's own shutdown (power menu, long press) closes a running game with
# SIGTERM so it can save. Whatever the battery saver paused has to run again
# first, or it cannot act on that signal.
graceful_shutdown() {
  for pid in $(ps -eo pid,ni | awk '$2==-4 {print $1}'); do
    kill -CONT "$pid" 2>/dev/null
  done
  /etc/init.d/S31emulationstation resume >/dev/null 2>&1

  knulli-shutdown -s
}

check_auto_shutdown() {
  [ -f "$WAKE_TIME" ] || return 0
  read -r recorded < "$WAKE_TIME" 2>/dev/null || recorded=""
  rm -f "$WAKE_TIME"
  [ -n "$recorded" ] || return 0

  now=$(date +%s)
  # 10s grace period to protect against shift
  diff=$(( now - recorded ))
  [ "$diff" -lt 0 ] && diff=$(( -diff ))
  if [ "$diff" -le 10 ]; then
    log "woken by the shutdown alarm: shutting down"
    graceful_shutdown
  fi
}

check_idle_modes() {
  local MODE
  local TIMER
  local EXTENDED_MODE
  local EXTENDED_TIMER
  local IDLE_STATE

  MODE="$(/usr/bin/knulli-settings-get system.batterysaver.mode 2>/dev/null)"
  TIMER="$(/usr/bin/knulli-settings-get system.idlewatcher.timer 2>/dev/null)"
  EXTENDED_MODE="$(/usr/bin/knulli-settings-get system.batterysaver.extendedmode 2>/dev/null)"
  EXTENDED_TIMER="$(/usr/bin/knulli-settings-get system.idlewatcher.extendedtimer 2>/dev/null)"

  # Check first if initial mode is shutdown
  if [ "$MODE" = "shutdown" ] && [ -n "$TIMER" ]; then
    printf '%s' "$TIMER"
    return 0
  fi

  # If initial mode is not shutdown, check extended mode
  if [ "$EXTENDED_MODE" = "shutdown" ]; then
    if [ -r "$IDLE_STATE_FILE" ]; then # Check if idlewatcher called suspend so we know initial mode timer is spent
      read -r IDLE_STATE < "$IDLE_STATE_FILE" 2>/dev/null
    else
      IDLE_STATE=""
    fi

    if [ "$IDLE_STATE" = "0" ]; then
      if [ -n "$EXTENDED_TIMER" ]; then
        printf '%s' "$EXTENDED_TIMER"
        return 0
      fi
    else
      if [ -n "$TIMER" ] && [ -n "$EXTENDED_TIMER" ]; then
        printf '%s' $(( TIMER + EXTENDED_TIMER ))
        return 0
      fi
    fi
  fi

  # No rtc timer
  return 1
}

# A non-negative integer setting, or the default when unset or invalid
setting_number() {
  local VALUE

  VALUE="$(/usr/bin/knulli-settings-get "$1" 2>/dev/null)"
  case "$VALUE" in
    ''|*[!0-9]*) VALUE="$2" ;;
  esac
  printf '%s' "$VALUE"
}

check_suspend_timer() {
  local TIMER

  TIMER="$(setting_number system.suspend.shutdowntimer "$DEFAULT_SUSPEND_TIMER")"
  [ "$TIMER" -gt 0 ] || return 1
  printf '%s' "$TIMER"
}

# Seconds until the battery would reach the floor; nothing on external power
check_battery_timer() {
  local FLOOR
  local CAPACITY=""
  local STATUS=""
  local SECS

  FLOOR="$(setting_number system.suspend.shutdownbattery "$DEFAULT_SUSPEND_BATTERY")"
  [ "$FLOOR" -gt 0 ] || return 1

  for supply in /sys/class/power_supply/*; do
    [ "$(cat "$supply/type" 2>/dev/null)" = "Battery" ] || continue
    read -r CAPACITY < "$supply/capacity" 2>/dev/null
    read -r STATUS < "$supply/status" 2>/dev/null
    break
  done

  [ "$STATUS" = "Discharging" ] || return 1
  case "$CAPACITY" in
    ''|*[!0-9]*) return 1 ;;
  esac

  SECS=$(( (CAPACITY - FLOOR) * SECS_PER_PERCENT ))
  [ "$SECS" -ge 300 ] || SECS=300
  printf '%s' "$SECS"
}

# "<seconds> <reason>" for the soonest shutdown timer, if any
get_shutdown_plan() {
  local PLAN=""
  local SECS

  if SECS="$(check_idle_modes)"; then
    PLAN="$SECS battery-saver"
  fi
  if SECS="$(check_suspend_timer)"; then
    if [ -z "$PLAN" ] || [ "$SECS" -lt "${PLAN%% *}" ]; then
      PLAN="$SECS suspend-timer"
    fi
  fi
  if SECS="$(check_battery_timer)"; then
    if [ -z "$PLAN" ] || [ "$SECS" -lt "${PLAN%% *}" ]; then
      PLAN="$SECS low-battery"
    fi
  fi

  [ -n "$PLAN" ] || return 1
  printf '%s' "$PLAN"
}

RTC_TIMER=""

if rtc_plan="$(get_shutdown_plan)"; then
  rtc_secs="${rtc_plan%% *}"
  clear_rtcs
  if arm_rtcs "$rtc_secs"; then
    RTC_TIMER="$rtc_secs"
    save_time "$RTC_TIMER"
    log "suspend: shutdown alarm in ${rtc_secs}s (${rtc_plan#* })"
  else
    rm -f "$WAKE_TIME" 2>/dev/null
    log "suspend: could not arm an RTC alarm"
  fi
else
  clear_rtcs
  rm -f "$WAKE_TIME" 2>/dev/null
fi

pm-is-supported --suspend >/dev/null 2>&1 && pm-suspend

clear_rtcs # Make sure any timers are cleared after suspending

check_auto_shutdown

sleep 0.5 # For a small debounce

exit 0
